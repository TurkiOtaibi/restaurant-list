# Shared local development settings.
APP_ENV=development
POSTGRES_DB=restaurant_wishlist
POSTGRES_USER=restaurant_user
POSTGRES_PASSWORD=restaurant_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql+asyncpg://restaurant_user:restaurant_password@localhost:5432/restaurant_wishlist

# Replace all secrets for real environments.
JWT_ACCESS_SECRET=dev-only-access-secret-placeholder-32-bytes
JWT_REFRESH_SECRET=dev-only-refresh-secret-placeholder-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
REFRESH_COOKIE_NAME=restaurant_refresh_token
REFRESH_COOKIE_SECURE=true
REFRESH_COOKIE_SAMESITE=lax
AUTH_RATE_LIMIT_REQUESTS=100
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
ENABLE_API_DOCS=false
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]

NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
