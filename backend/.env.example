APP_NAME=Restaurant Wishlist API
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://restaurant_user:restaurant_password@localhost:5432/restaurant_wishlist
JWT_ACCESS_SECRET=dev-only-access-secret-placeholder-32-bytes
JWT_REFRESH_SECRET=dev-only-refresh-secret-placeholder-32-bytes
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
AUTH_RATE_LIMIT_REQUESTS=10
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
PUBLIC_READ_RATE_LIMIT_REQUESTS=60
PUBLIC_READ_RATE_LIMIT_WINDOW_SECONDS=60
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
POSTGRES_TEST_DATABASE_URL=postgresql+asyncpg://restaurant_user:restaurant_password@localhost:5432/restaurant_wishlist_test
