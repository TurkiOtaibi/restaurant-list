APP_NAME=Restaurant Wishlist API
APP_ENV=development
DATABASE_URL=postgresql+asyncpg://restaurant_user:restaurant_password@localhost:5432/restaurant_wishlist
JWT_ACCESS_SECRET=change-me-access-secret
JWT_REFRESH_SECRET=change-me-refresh-secret
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30
CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
POSTGRES_TEST_DATABASE_URL=postgresql+asyncpg://restaurant_user:restaurant_password@localhost:5432/restaurant_wishlist_test
